# ==============================================================================
# Claimly Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Replace the placeholder values below with your authentic Supabase project
#    credentials obtained from your Supabase Dashboard or local CLI output.
#
# IMPORTANT SECURITY NOTICE:
# NEVER commit your actual .env file or production secret keys to version control.
# The anon key is safe for client-side injection, whereas the service_role key
# must be strictly restricted to server environments, migrations, and test scripts.
# ==============================================================================

# Application Environment ('development', 'staging', 'production')
APP_ENV=development

# ------------------------------------------------------------------------------
# Supabase Project Backend Credentials
# ------------------------------------------------------------------------------
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
# Format for cloud hosting: https://<project-ref>.supabase.co
# Format for local Docker stack: http://127.0.0.1:54321
SUPABASE_URL=https://your-project-ref.supabase.co
project_url=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key:
# Safe to expose in frontend client applications (Flutter mobile/web).
# PostgREST and GoTrue use this key to identify your project and enforce Row
# Level Security (RLS) based on the user's authenticated JSON Web Token (JWT).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-token-here
anon_public_key=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-token-here

# Supabase Service Role Secret Key (HIGH PRIVILEGE):
# CRITICAL: NEVER embed or bundle this key within Flutter mobile or web binaries.
# This key completely bypasses PostgreSQL Row Level Security (RLS) policies.
# It is used strictly by:
# 1. Supabase Edge Functions for internal admin actions (e.g., system notifications).
# 2. Administrative test runners and database seeding scripts (tool/seed_test_db.sh).
# 3. Server-side CI/CD deployment pipelines.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-token-here
service_role=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-token-here

# ------------------------------------------------------------------------------
# PostgreSQL Database Direct Connection String
# ------------------------------------------------------------------------------
# Used by the Supabase CLI for database migrations and standalone DDL execution.
# Standard Direct Connection:
# postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# Transaction Pooler (recommended for serverless environments and IPv4 networks):
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
direct_connection_string=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Optional Legacy JWT Secret (used for custom server token verification)
legacy_jwt_secret=your-legacy-jwt-secret-base64

# Optional CLI Secret Keys
secret_keys=sb_secret_your-cli-secret-key-here
